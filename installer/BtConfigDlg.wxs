<?xml version="1.0" encoding="UTF-8"?>
<!--
  BtConfigDlg — Custom wizard page for btplus installer
  Appears between WelcomeDlg and InstallDirDlg.

  Captures two user-configurable properties:
    DEVICE_NAME           — Bluetooth device name (case-insensitive match)
    POLL_INTERVAL_SECONDS — Fallback poll interval in seconds (min: 5)

  These properties are written to btplus.ini via IniFile elements in btplus.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="BtConfigDlg" Width="370" Height="270" Title="[ProductName] Setup">

        <!-- ─── Banner (matches standard WiX installer look) ─────────────── -->
        <Control Id="BannerBitmap"
                 Type="Bitmap"
                 X="0" Y="0" Width="370" Height="44"
                 TabSkip="no"
                 Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine"
                 Type="Line"
                 X="0" Y="44" Width="370" Height="0" />

        <!--
          WiX v4: Control text for formatted strings (e.g. font overrides) must
          use a <Text Value="..." /> child element, NOT inner text.
          Plain text controls use the Text attribute directly on <Control>.
        -->
        <Control Id="TitleText"
                 Type="Text"
                 X="15" Y="6" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}Configure btplus" />
        </Control>
        <Control Id="SubtitleText"
                 Type="Text"
                 X="15" Y="23" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Set your Bluetooth device and connection preferences." />

        <!-- ─── Device Name ──────────────────────────────────────────────── -->
        <Control Id="DeviceNameLabel"
                 Type="Text"
                 X="20" Y="58" Width="330" Height="12"
                 NoPrefix="yes"
                 Text="Bluetooth Device Name:" />
        <Control Id="DeviceNameHint"
                 Type="Text"
                 X="20" Y="71" Width="330" Height="10"
                 Transparent="yes" NoPrefix="yes"
                 Text="Enter the exact name shown in Bluetooth Settings (case-insensitive)." />
        <!--
          Edit control bound to the DEVICE_NAME property.
          Text="{100}" sets the maximum character limit to 100.
        -->
        <Control Id="DeviceNameEdit"
                 Type="Edit"
                 X="20" Y="84" Width="330" Height="18"
                 Property="DEVICE_NAME"
                 Text="{100}" />

        <!-- ─── Poll Interval ────────────────────────────────────────────── -->
        <Control Id="PollLabel"
                 Type="Text"
                 X="20" Y="118" Width="330" Height="12"
                 NoPrefix="yes"
                 Text="Fallback Poll Interval (seconds):" />
        <Control Id="PollHint"
                 Type="Text"
                 X="20" Y="131" Width="330" Height="10"
                 Transparent="yes" NoPrefix="yes"
                 Text="Scans for the device when no arrival event fires. Minimum: 5. Default: 30." />
        <!--
          Edit control bound to POLL_INTERVAL_SECONDS.
          Text="{5}" limits input to 5 characters.
        -->
        <Control Id="PollEdit"
                 Type="Edit"
                 X="20" Y="144" Width="60" Height="18"
                 Property="POLL_INTERVAL_SECONDS"
                 Text="{5}" />

        <!-- ─── Bottom line + navigation buttons ────────────────────────── -->
        <Control Id="BottomLine"
                 Type="Line"
                 X="0" Y="234" Width="370" Height="0" />

        <!--
          WiX v4: Publish conditions must use the Condition attribute.
          Inner text conditions (WiX v3 style) are no longer supported.
        -->
        <Control Id="Back"
                 Type="PushButton"
                 X="156" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" Condition="1" />
        </Control>

        <Control Id="Next"
                 Type="PushButton"
                 X="216" Y="243" Width="56" Height="17"
                 Default="yes"
                 Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="InstallDirDlg" Condition="1" />
        </Control>

        <Control Id="Cancel"
                 Type="PushButton"
                 X="304" Y="243" Width="56" Height="17"
                 Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>

      </Dialog>
    </UI>
  </Fragment>
</Wix>
